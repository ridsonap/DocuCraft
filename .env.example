# DocuCraft Environment Variables

# Backend internal URL for Next.js rewrite proxy
# In Docker compose: http://backend:8000
# In local dev: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Direct public API URL (leave empty when using Next.js proxy)
NEXT_PUBLIC_API_URL=

# Backend CORS allowed origins (comma-separated or * for all)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Port configuration
PORT=3000
BACKEND_PORT=8000
