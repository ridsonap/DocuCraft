# DocuCraft backend — environment variables
# Copy to .env for local development (uvicorn reads via os.environ).

# Storage backend: "memory" for local dev/tests, "blob" for Vercel production.
STORAGE_BACKEND=memory

# Required when STORAGE_BACKEND=blob.
# Vercel Dashboard → Storage → your Blob store → ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# Comma-separated CORS origins. Lock this to your frontend URL in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
